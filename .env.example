# Origem da API Django (sem caminho /api). Embutida no build.
# Desenvolvimento local; no build de produção, use uma origem HTTPS pública.
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=https://api.seudominio.com.br
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Segredo compartilhado com a API (FRONTEND_PROXY_SECRET lá). Só no servidor
# (sem NEXT_PUBLIC_): o proxy.ts manda o IP do usuário assinado para o
# rate limit da API não tratar todo mundo como o IP da Vercel.
# API_PROXY_SECRET=
